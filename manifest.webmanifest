{
  "id": "./",
  "name": "AnalogScope – Earth analogs for Moon & Mars",
  "short_name": "AnalogScope",
  "description": "Find, score and compare places on Earth that resemble future Moon and Mars base sites, using live NASA, JAXA, ESA and NOAA data. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#070b16",
  "theme_color": "#070b16",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "science",
    "navigation",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
